              <mxPoint x="1430" y="90"/>
              <mxPoint x="1430" y="360"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_kpre_to_int" value="i_step_phase" style="endArrow=classic;html=1;fontSize=9;" edge="1" parent="1" source="kpre_path" target="integrator">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_kfgate_to_int" value="i_step_df" style="endArrow=classic;html=1;fontSize=9;" edge="1" parent="1" source="kf_gate" target="integrator">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1430" y="460"/>
              <mxPoint x="1430" y="220"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_int_to_sum" value="i_state &gt;&gt; I_FRAC_BITS" style="endArrow=classic;html=1;fontSize=9;" edge="1" parent="1" source="integrator" target="sum_sat">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_sum_to_off" value="" style="endArrow=classic;html=1;" edge="1" parent="1" source="sum_sat" target="offset_out">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_hyst_to_lockout" value="" style="endArrow=classic;html=1;" edge="1" parent="1" source="lock_hyst" target="lock_out">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e_lock_fb_to_kfgate" value="gate" style="endArrow=classic;html=1;dashed=1;strokeColor=#a53737;fontSize=9;fontColor=#a53737;" edge="1" parent="1" source="lock_hyst" target="kf_gate">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1450" y="680"/>
              <mxPoint x="1340" y="680"/>
              <mxPoint x="1340" y="500"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e_phase_for_pll_q" value="" style="endArrow=classic;html=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="phase_for_pll_out" target="q_sample_in">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_df_for_pll_df" value="" style="endArrow=classic;html=1;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="df_for_pll_out" target="df_sample_in">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="legend_box" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#000;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="120" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="legend_phase" value="phase / q-path  (LPF → PI)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1">
          <mxGeometry x="180" y="900" width="220" height="30" as="geometry"/>
