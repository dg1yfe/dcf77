          <mxGeometry x="920" y="900" width="200" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="legend_gate" value="lock-state feedback (gates df path)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#a53737;align=center;dashed=1;fontColor=#a53737;" vertex="1" parent="1">
          <mxGeometry x="1140" y="900" width="280" height="30" as="geometry"/>
