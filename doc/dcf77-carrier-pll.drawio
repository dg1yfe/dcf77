        </mxCell>

        <mxCell id="df_sample_in" value="df_sample&#10;signed(28..0)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;" vertex="1" parent="1">
          <mxGeometry x="640" y="500" width="120" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="df_lpf" value="20 Hz LPF&#10;y += (x − y) &gt;&gt; 4&#10;(same SHIFT=4)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;" vertex="1" parent="1">
          <mxGeometry x="800" y="490" width="160" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="df_filt" value="df_filt" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;" vertex="1" parent="1">
          <mxGeometry x="1000" y="500" width="120" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="kf_gate" value="i_step_df&#10;= df_filt &gt;&gt; KF_SHIFT (=4)&#10;ENABLED iff lock_state = '0'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1170" y="420" width="240" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="slow_iir" value="Slow lock IIR&#10;y += (x − y) &gt;&gt; LOCK_IIR_SHIFT&#10;(=14, τ ≈ 8 s)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;" vertex="1" parent="1">
          <mxGeometry x="1170" y="540" width="240" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="q_lock_iir" value="q_lock_iir&#10;≈ Δf × 4194 LSB" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;" vertex="1" parent="1">
          <mxGeometry x="1450" y="545" width="160" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="lock_hyst" value="Lock hysteresis on |q_lock_iir|&#10;in_band   if |·| &lt; LOCK_IN_THR  = 2^11  (Δf &lt; ~0.49 Hz)&#10;out_band  if |·| ≥ LOCK_OUT_THR = 2^13 (Δf &gt; ~2 Hz)&#10;state change after LOCK_HOLD_TICKS = 49152 (~25 s)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;" vertex="1" parent="1">
          <mxGeometry x="1450" y="630" width="380" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="e_dfin_dflpf" value="" style="endArrow=classic;html=1;" edge="1" parent="1" source="df_sample_in" target="df_lpf">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_dflpf_dffilt" value="" style="endArrow=classic;html=1;" edge="1" parent="1" source="df_lpf" target="df_filt">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_dffilt_kfgate" value="" style="endArrow=classic;html=1;" edge="1" parent="1" source="df_filt" target="kf_gate">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_dffilt_slowiir" value="" style="endArrow=classic;html=1;" edge="1" parent="1" source="df_filt" target="slow_iir">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_slowiir_qlock" value="" style="endArrow=classic;html=1;" edge="1" parent="1" source="slow_iir" target="q_lock_iir">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_qlock_hyst" value="" style="endArrow=classic;html=1;" edge="1" parent="1" source="q_lock_iir" target="lock_hyst">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="integrator" value="Integrator i_state&#10;(ISTATE_W = OFFSET_W&#10;     + I_FRAC_BITS + 4)&#10;i_state += i_step_phase&#10;            + (i_step_df if !lock)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;" vertex="1" parent="1">
          <mxGeometry x="1470" y="160" width="240" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="sum_sat" value="offset = sat_to(&#10;   i_state &gt;&gt; I_FRAC_BITS&#10; + p_path,&#10;   OFFSET_WIDTH=24)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;" vertex="1" parent="1">
          <mxGeometry x="1470" y="310" width="240" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="offset_out" value="phase_inc_offset&#10;signed(23..0)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1760" y="335" width="140" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="lock_out" value="lock_state&#10;std_logic" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1760" y="660" width="140" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="e_kp_to_sum" value="p_path" style="endArrow=classic;html=1;fontSize=9;" edge="1" parent="1" source="kp_path" target="sum_sat">
          <mxGeometry relative="1" as="geometry">
